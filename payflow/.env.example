# PayFlow Environment Configuration

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=payflow_db
DB_USER=payflow_user
DB_PASSWORD=payflow_pass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# External URLs
SIMULATOR_BASE_URL=http://provider-simulator:8081/api/simulator
WEBHOOK_SERVICE_URL=http://webhook-service:8082/api/v1/webhooks
WEBHOOK_SECRET=whsec_test_secret_key_1234567890

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
